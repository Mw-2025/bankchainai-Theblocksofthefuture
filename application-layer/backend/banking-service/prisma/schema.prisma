// --- Configuration ---
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS for Institutional Integrity ---
enum AccountType {
  PRIMARY_CHECKING
  SAVINGS_HYS
  RETIREMENT_401K
  RETIREMENT_ROTH_IRA
  CRYPTO_WALLET
  REAL_ESTATE_PORTFOLIO
}

enum TransactionStatus {
  PENDING
  ORACLE_REVIEW
  VALIDATOR_ENFORCED
  REJECTED
  COMPLETED
}

// --- CORE MODELS ---
model User {
  id                String            @id @default(uuid())
  email             String            @unique
  didIdentifier     String?           @unique
  kycStatus         String            @default("UNVERIFIED")
  
  kycProfile        KYCProfile?
  accounts          BankAccount[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("banking_users")
}

model BankAccount {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  
  type              AccountType
  accountNumber     String      @unique
  
  balanceFiat       Decimal     @default(0) @db.Decimal(20, 2)
  balanceBankToken  Decimal     @default(0) @db.Decimal(20, 8)
  
  interestRate      Decimal?    @db.Decimal(5, 2)
  isFrozen          Boolean     @default(false)
  
  metadata          Json?

  transactions      TransactionLedger[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("bank_accounts")
}

model TransactionLedger {
  id                String            @id @default(uuid())
  accountId         String
  account           BankAccount       @relation(fields: [accountId], references: [id])
  
  amount            Decimal           @db.Decimal(20, 8)
  currency          String            @default("USD") // USD | BKC | BKCX
  status            TransactionStatus @default(PENDING)

  blockchainHash    String?           @unique
  oracleSignature   String?
  validatorNodeId   String?
  chainSlot         Int?
  chainCluster      String            @default("mainnet")
  
  referenceId       String?
  note              String?

  createdAt         DateTime          @default(now())

  @@index([accountId])
  @@index([blockchainHash])
  @@map("banking_ledger")
}

model KYCProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  
  fullName          String
  taxIdEncrypted    String
  riskLevel         Int       @default(0)
  lastVerified      DateTime?

  @@map("banking_kyc")
}

// BKC native chain + BKCX bank tokens, indexed from BankChainAI-TheBlocksofthefuture
model ChainCheckpoint {
  id              String   @id @default(uuid())
  githubRepo      String   @default("bankchainai/BankchainAI-TheBlocksofthefuture")
  cluster         String   @default("mainnet")
  slot            Int
  blockhash       String
  genesisHash     String?
  nativeSymbol    String   @default("BKC")
  tokenSymbol     String   @default("BKCX")
  transactionCount Int     @default(0)
  indexedAt       DateTime @default(now())

  @@index([slot])
  @@map("bkc_chain_checkpoints")
}